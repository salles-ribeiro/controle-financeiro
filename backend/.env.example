# Porta em que o servidor Express vai rodar
PORTA_DO_SERVIDOR=3001

# Chave secreta usada para assinar os tokens JWT — OBRIGATÓRIA (o servidor
# recusa iniciar sem ela). Gere um valor aleatório forte com o comando:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca reaproveite o valor de exemplo abaixo fora do seu ambiente local.
CHAVE_SECRETA_DO_TOKEN=altere-esta-chave-em-producao

# URL exata do seu frontend em produção (ex.: https://seu-app.vercel.app).
# Restringe quem pode chamar esta API. Em desenvolvimento local pode deixar
# comentado (libera qualquer origem).
# URL_DO_FRONTEND_PERMITIDA=https://seu-app.vercel.app

# --- Banco de dados ---
# Em desenvolvimento local, deixe as duas linhas abaixo comentadas: o
# projeto usa automaticamente um arquivo SQLite em backend/dados/.
#
# Em produção (deploy no Render, por exemplo), crie um banco gratuito em
# https://turso.tech, e preencha as duas variáveis abaixo com os valores
# que o Turso fornecer (veja o guia de deploy para o passo a passo):
# TURSO_DATABASE_URL=libsql://nome-do-seu-banco-sua-org.turso.io
# TURSO_AUTH_TOKEN=o-token-gerado-pelo-turso
